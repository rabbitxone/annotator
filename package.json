{
  "name": "annotator",
  "version": "3.2.0",
  "private": true,
  "description": "Privacy-focused web annotations",
  "license": "Apache-2.0",
  "author": "Filip Polak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rabbitxone/annotator.git"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "package": "node scripts/build.mjs --package",
    "icons": "node scripts/render-icons.mjs",
    "test": "node --test \"test/unit/*.test.js\"",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "version": "node scripts/sync-citation.mjs && git add CITATION.cff"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@mozilla/readability": "^0.6.0",
    "esbuild": "^0.28.2",
    "web-ext": "^10.8.0"
  }
}
